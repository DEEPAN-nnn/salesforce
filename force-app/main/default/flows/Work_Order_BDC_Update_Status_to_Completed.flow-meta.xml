    <decisions>
        <name>Cancel_Eligibility</name>
        <label>Cancel Eligibility</label>
        <locationX>446</locationX>
        <locationY>215</locationY>
        <defaultConnector>
            <targetReference>Get_SA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a cancel (check complete)</defaultConnectorLabel>
        <rules>
            <name>Cancelled_Exported</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.POStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Exported</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cannot_Cancel_Exported</targetReference>
            </connector>
            <label>Cancelled but Exported</label>
        </rules>
        <rules>
            <name>Cancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.POStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_By_pass_workorder_Flow</targetReference>
            </connector>
            <label>Cancelled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Scheduled_Date_Check</name>
        <label>Scheduled Date Check</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>SA not ended yet — do not complete</defaultConnectorLabel>
        <rules>
            <name>Scheduled_Date_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ScheduledDateLessThanToday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.POStatus__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>By_pass_workorder_Flow</targetReference>
            </connector>
            <label>Scheduled Date &lt;= Today</label>
        </rules>
    </decisions>
    <description>When BDC client POStatus changes to Completed, set Salesforce WO to Completed / Pending Installer Pay (if the service appointment has ended). When POStatus changes to cancelled, set Salesforce WO to Canceled — unless Status is Exported, in which case show an error and roll back so the user knows the WO cannot be cancelled.</description>
    <environments>Default</environments>
    <formulas>
        <name>LessThanToday</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>ScheduledDateLessThanToday</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Get_SA.SchedEndTime} &lt;= now(), TRUE, FALSE)</expression>
    </formulas>
    <interviewLabel>Work Order: BDC - Update Status to Completed {!$Flow.CurrentDateTime}</interviewLabel>
