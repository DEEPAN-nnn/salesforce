<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Custom Highlights Panel</masterLabel>
    <description>Custom Sales Funnel highlight panel with Follow, primary actions, overflow menu, and flow modals.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Enquiry__c</object>
            </objects>
            <property
                name="iconName"
                type="String"
                label="Icon Name"
                description="SLDS icon, e.g. standard:opportunity"
                default="standard:opportunity"/>
            <property
                name="iconColor"
                type="String"
                label="Icon Background Color"
                description="Hex color for the icon container"
                default="#5867E8"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
